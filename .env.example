# Browser requests use the same-origin proxy.
VITE_API_URL=/api/v1

# Server-only proxy settings. Set the key privately; never use VITE_API_KEY.
MSGVAULT_API_URL=http://127.0.0.1:8080
MSGVAULT_API_KEY=
MSGVAULT_FRONTEND_HOST=127.0.0.1
# Comma-separated hostnames allowed by Vite, if using tailnet DNS.
# MSGVAULT_FRONTEND_ALLOWED_HOSTS=rack-mini,rack-mini.local
